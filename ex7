#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 5000

struct Message
{
    float num1;
    float num2;
    char op;
};

int main()
{
    int sockfd;
    struct sockaddr_in server, client;
    struct Message msg;
    char result[100];
    socklen_t len = sizeof(client);

    // Create UDP socket
    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0)
    {
        perror("Socket creation failed");
        return 1;
    }

    // Server address
    server.sin_family = AF_INET;
    server.sin_addr.s_addr = INADDR_ANY;
    server.sin_port = htons(PORT);

    // Bind socket
    if (bind(sockfd, (struct sockaddr *)&server, sizeof(server)) < 0)
    {
        perror("Bind failed");
        close(sockfd);
        return 1;
    }

    printf("UDP Arithmetic Server started...\n");
    printf("Waiting for client...\n");

    while (1)
    {
        // Receive data from client
        recvfrom(sockfd, &msg, sizeof(msg), 0,
                 (struct sockaddr *)&client, &len);

        printf("\nReceived: %.2f %c %.2f\n",
               msg.num1, msg.op, msg.num2);

        // Perform operation
        switch (msg.op)
        {
            case '+':
                sprintf(result, "Result = %.2f",
                        msg.num1 + msg.num2);
                break;

            case '-':
                sprintf(result, "Result = %.2f",
                        msg.num1 - msg.num2);
                break;

            case '*':
                sprintf(result, "Result = %.2f",
                        msg.num1 * msg.num2);
                break;

            case '/':
                if (msg.num2 == 0)
                {
                    strcpy(result, "Error: Division by zero is not allowed");
                }
                else
                {
                    sprintf(result, "Result = %.2f",
                            msg.num1 / msg.num2);
                }
                break;

            case 'e':
                strcpy(result, "Server shutting down...");
                sendto(sockfd, result, strlen(result) + 1, 0,
                       (struct sockaddr *)&client, len);

                close(sockfd);
                return 0;

            default:
                strcpy(result, "Error: Invalid operation");
        }

        // Send result to client
        sendto(sockfd, result, strlen(result) + 1, 0,
               (struct sockaddr *)&client, len);
    }

    close(sockfd);
    return 0;
}

