#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <ctype.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8040
#define SIZE 1024
#define MAX 5

struct Book {
    int id;
    char title[100];
    char author[100];
    char category[50];
    int available;
    char issued_to[100];
};

struct Book books[MAX] = {
    {101, "C Programming", "Dennis Ritchie", "Programming", 1, ""},
    {102, "Java Programming", "James Gosling", "Programming", 1, ""},
    {103, "Computer Networks", "Tanenbaum", "Networking", 1, ""},
    {104, "Operating Systems", "Galvin", "OS", 1, ""},
    {105, "Database Systems", "Elmasri", "DBMS", 1, ""}
};

int send_msg(int fd, const char *msg) {
    size_t len = strlen(msg), sent = 0;

    while (sent < len) {
        ssize_t n = send(fd, msg + sent, len - sent, 0);
        if (n <= 0) return -1;
        sent += n;
    }
    return 0;
}

int recv_line(int fd, char *buf, int size) {
    int i = 0;
    char ch;

    while (i < size - 1) {
        ssize_t n = recv(fd, &ch, 1, 0);

        if (n <= 0) return -1;
        if (ch == '\n') break;
        if (ch != '\r') buf[i++] = ch;
    }

    buf[i] = '\0';
    return i;
}

int find_book(int id) {
    int i;

    for (i = 0; i < MAX; i++) {
        if (books[i].id == id)
            return i;
    }

    return -1;
}

int match(const char *text, const char *key) {
    int i, j;

    for (i = 0; text[i]; i++) {
        for (j = 0; key[j] && text[i + j] &&
             tolower((unsigned char)text[i + j]) ==
             tolower((unsigned char)key[j]); j++)
            ;

        if (key[j] == '\0')
            return 1;
    }

    return key[0] == '\0';
}

void process(int fd, char *cmd) {
    char *action, *a, *b;
    char out[SIZE];
    int id, i, found = 0;

    action = strtok(cmd, "|");
    a = strtok(NULL, "|");
    b = strtok(NULL, "|");

    if (action == NULL) {
        send_msg(fd, "Invalid request.\n");
        return;
    }

    if (strcmp(action, "SEARCH_TITLE") == 0 ||
        strcmp(action, "SEARCH_AUTHOR") == 0) {

        if (a == NULL || *a == '\0') {
            send_msg(fd, "Enter a search keyword.\nEND\n");
            return;
        }

        for (i = 0; i < MAX; i++) {
            int ok;

            if (strcmp(action, "SEARCH_TITLE") == 0)
                ok = match(books[i].title, a);
            else
                ok = match(books[i].author, a);

            if (ok) {
                snprintf(out, sizeof(out),
                    "ID:%d | Title:%s | Author:%s | Category:%s | Status:%s\n",
                    books[i].id, books[i].title, books[i].author,
                    books[i].category,
                    books[i].available ? "Available" : "Issued");

                if (send_msg(fd, out) < 0) return;
                found = 1;
            }
        }

        if (!found)
            send_msg(fd, "No matching books found.\n");

        send_msg(fd, "END\n");
    }

    else if (strcmp(action, "CHECK") == 0) {
        char *end;
        long value;

        if (a == NULL || *a == '\0') {
            send_msg(fd, "Invalid Book ID.\n");
            return;
        }

        value = strtol(a, &end, 10);

        if (*end != '\0' || value <= 0 || value > 2147483647L) {
            send_msg(fd, "Invalid Book ID.\n");
            return;
        }

        id = (int)value;
        i = find_book(id);

        if (i == -1) {
            snprintf(out, sizeof(out), "Book ID %d not found.\n", id);
            send_msg(fd, out);
        } else {
            snprintf(out, sizeof(out),
                "Book ID:%d | Title:%s | Status:%s\n",
                books[i].id, books[i].title,
                books[i].available ? "Available" : "Issued");
            send_msg(fd, out);
        }
    }

    else if (strcmp(action, "ISSUE") == 0) {
        char *end;
        long value;

        if (a == NULL || b == NULL || *b == '\0') {
            send_msg(fd, "Usage: ISSUE|BookID|StudentName\n");
            return;
        }

        value = strtol(a, &end, 10);

        if (*end != '\0' || value <= 0 || value > 2147483647L) {
            send_msg(fd, "Invalid Book ID.\n");
            return;
        }

        id = (int)value;
        i = find_book(id);

        if (i == -1)
            send_msg(fd, "Book not found.\n");
        else if (!books[i].available)
            send_msg(fd, "Book is already issued.\n");
        else {
            books[i].available = 0;
            snprintf(books[i].issued_to,
                     sizeof(books[i].issued_to), "%s", b);
            snprintf(out, sizeof(out),
                     "Book ID %d issued successfully to %s.\n",
                     id, books[i].issued_to);
            send_msg(fd, out);
        }
    }

    else if (strcmp(action, "RETURN") == 0) {
        char *end;
        long value;

        if (a == NULL || *a == '\0' || b == NULL || *b == '\0') {
            send_msg(fd, "Usage: RETURN|BookID|StudentName\n");
            return;
        }

        value = strtol(a, &end, 10);

        if (*end != '\0' || value <= 0 || value > 2147483647L) {
            send_msg(fd, "Invalid Book ID.\n");
            return;
        }

        id = (int)value;
        i = find_book(id);

        if (i == -1)
            send_msg(fd, "Book not found.\n");
        else if (books[i].available)
            send_msg(fd, "Book is not currently issued.\n");
        else if (strcmp(b, books[i].issued_to) != 0)
            send_msg(fd, "Student name does not match.\n");
        else {
            books[i].available = 1;
            books[i].issued_to[0] = '\0';
            snprintf(out, sizeof(out),
                     "Book ID %d returned successfully.\n", id);
            send_msg(fd, out);
        }
    }

    else if (strcmp(action, "ISSUED") == 0) {
        for (i = 0; i < MAX; i++) {
            if (!books[i].available) {
                snprintf(out, sizeof(out),
                    "ID:%d | Title:%s | Author:%s | Issued to:%s\n",
                    books[i].id, books[i].title,
                    books[i].author, books[i].issued_to);

                if (send_msg(fd, out) < 0) return;
                found = 1;
            }
        }

        if (!found)
            send_msg(fd, "No books are currently issued.\n");

        send_msg(fd, "END\n");
    }

    else {
        send_msg(fd, "Invalid command.\n");
    }
}

int main(void) {
    int server_fd, client_fd, opt = 1;
    struct sockaddr_in addr;
    char buf[SIZE];

    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd < 0) {
        perror("socket");
        return 1;
    }

    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR,
               &opt, sizeof(opt));

    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = htonl(INADDR_ANY);
    addr.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
        perror("bind");
        close(server_fd);
        return 1;
    }

    if (listen(server_fd, 5) < 0) {
        perror("listen");
        close(server_fd);
        return 1;
    }

    printf("Library server running on port %d\n", PORT);

    while (1) {
        client_fd = accept(server_fd, NULL, NULL);

        if (client_fd < 0) {
            perror("accept");
            continue;
        }

        printf("Client connected.\n");
        send_msg(client_fd, "Welcome to College Library!\n");

        while (1) {
            int n = recv_line(client_fd, buf, sizeof(buf));

            if (n < 0) break;

            if (strcmp(buf, "exit") == 0) {
                send_msg(client_fd, "Goodbye!\n");
                break;
            }

            process(client_fd, buf);
        }

        close(client_fd);
        printf("Client disconnected. Waiting for next client.\n");
    }

    close(server_fd);
    return 0;
}

