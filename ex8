#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8040
#define SIZE 1024

int send_msg(int fd, const char *msg) {
    size_t len = strlen(msg), sent = 0;

    while (sent < len) {
        ssize_t n = send(fd, msg + sent, len - sent, 0);
        if (n <= 0) return -1;
        sent += n;
    }

    return 0;
}

int recv_line(int fd, char *buf, int size) {
    int i = 0;
    char ch;

    while (i < size - 1) {
        ssize_t n = recv(fd, &ch, 1, 0);

        if (n <= 0) return -1;
        if (ch == '\n') break;
        if (ch != '\r') buf[i++] = ch;
    }

    buf[i] = '\0';
    return i;
}

void get_input(char *buf, int size) {
    if (fgets(buf, size, stdin) == NULL) {
        buf[0] = '\0';
        return;
    }

    buf[strcspn(buf, "\n")] = '\0';
}

int main(void) {
    int sockfd, choice, id;
    struct sockaddr_in serv_addr;
    char cmd[SIZE], response[SIZE];
    char title[100], author[100], name[100];
    int multi;

    sockfd = socket(AF_INET, SOCK_STREAM, 0);

    if (sockfd < 0) {
        perror("socket");
        return 1;
    }

    memset(&serv_addr, 0, sizeof(serv_addr));
    serv_addr.sin_family = AF_INET;
    serv_addr.sin_port = htons(PORT);
    inet_pton(AF_INET, "127.0.0.1", &serv_addr.sin_addr);

    if (connect(sockfd, (struct sockaddr *)&serv_addr,
                sizeof(serv_addr)) < 0) {
        perror("connect");
        close(sockfd);
        return 1;
    }

    if (recv_line(sockfd, response, sizeof(response)) < 0) {
        close(sockfd);
        return 1;
    }

    printf("%s\n", response);

    while (1) {
        printf("\n--- COLLEGE LIBRARY ---\n");
        printf("1. Search by title\n");
        printf("2. Search by author\n");
        printf("3. Check availability\n");
        printf("4. Issue book\n");
        printf("5. Return book\n");
        printf("6. View issued books\n");
        printf("7. Exit\n");
        printf("Enter choice: ");

        if (scanf("%d", &choice) != 1) {
            int ch;
            while ((ch = getchar()) != '\n' && ch != EOF);
            printf("Invalid choice.\n");
            continue;
        }
        getchar();

        multi = 0;

        switch (choice) {
            case 1:
                printf("Enter book title: ");
                get_input(title, sizeof(title));

                if (title[0] == '\0') {
                    printf("Title cannot be empty.\n");
                    continue;
                }

                snprintf(cmd, sizeof(cmd),
                         "SEARCH_TITLE|%s\n", title);
                multi = 1;
                break;

            case 2:
                printf("Enter author name: ");
                get_input(author, sizeof(author));

                if (author[0] == '\0') {
                    printf("Author cannot be empty.\n");
                    continue;
                }

                snprintf(cmd, sizeof(cmd),
                         "SEARCH_AUTHOR|%s\n", author);
                multi = 1;
                break;

            case 3:
                printf("Enter Book ID: ");

                if (scanf("%d", &id) != 1) {
                    int ch;
                    while ((ch = getchar()) != '\n' && ch != EOF);
                    printf("Invalid Book ID.\n");
                    continue;
                }
                getchar();

                snprintf(cmd, sizeof(cmd), "CHECK|%d\n", id);
                break;

            case 4:
                printf("Enter Book ID: ");

                if (scanf("%d", &id) != 1) {
                    int ch;
                    while ((ch = getchar()) != '\n' && ch != EOF);
                    printf("Invalid Book ID.\n");
                    continue;
                }
                getchar();

                printf("Enter student name: ");
                get_input(name, sizeof(name));

                if (name[0] == '\0' || strchr(name, '|')) {
                    printf("Invalid student name.\n");
                    continue;
                }

                snprintf(cmd, sizeof(cmd),
                         "ISSUE|%d|%s\n", id, name);
                break;

            case 5:
                printf("Enter Book ID: ");

                if (scanf("%d", &id) != 1) {
                    int ch;
                    while ((ch = getchar()) != '\n' && ch != EOF);
                    printf("Invalid Book ID.\n");
                    continue;
                }
                getchar();

                printf("Enter student name: ");
                get_input(name, sizeof(name));

                if (name[0] == '\0' || strchr(name, '|')) {
                    printf("Invalid student name.\n");
                    continue;
                }

                snprintf(cmd, sizeof(cmd),
                         "RETURN|%d|%s\n", id, name);
                break;

            case 6:
                strcpy(cmd, "ISSUED\n");
                multi = 1;
                break;

            case 7:
                strcpy(cmd, "exit\n");

                if (send_msg(sockfd, cmd) < 0) {
                    close(sockfd);
                    return 1;
                }

                if (recv_line(sockfd, response,
                              sizeof(response)) > 0)
                    printf("%s\n", response);

                close(sockfd);
                printf("Disconnected from server.\n");
                return 0;

            default:
                printf("Invalid choice. Try again.\n");
                continue;
        }

        if (send_msg(sockfd, cmd) < 0) {
            printf("Server connection lost.\n");
            break;
        }

        if (multi) {
            while (1) {
                if (recv_line(sockfd, response,
                              sizeof(response)) < 0) {
                    printf("Server disconnected.\n");
                    close(sockfd);
                    return 1;
                }

                if (strcmp(response, "END") == 0)
                    break;

                printf("%s\n", response);
            }
        } else {
            if (recv_line(sockfd, response,
                          sizeof(response)) < 0) {
                printf("Server disconnected.\n");
                break;
            }

            printf("%s\n", response);
        }
    }

    close(sockfd);
    printf("Disconnected from server.\n");
    return 0;
}
