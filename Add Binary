        int len=s.length();
        Map <Character,Integer> m=new HashMap<>();
        for(int i=0;i<len;i++){
            char c=s.charAt(i);
            m.put(c,m.getOrDefault(c,0)+1);
        }
        for(int i=0;i<len;i++) {
            char c=s.charAt(i);
             if(m.get(c)==1){
                return i;
            }
        }
        return -1;
    }
