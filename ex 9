#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/select.h>

#define PORT 8084
#define SIZE 1024

int send_all(int fd, const char *msg) {
    size_t len = strlen(msg), sent = 0;

    while (sent < len) {
        ssize_t n = send(fd, msg + sent, len - sent, 0);
        if (n <= 0)
            return -1;
        sent += n;
    }
    return 0;
}

int main(void) {
    int sockfd;
    struct sockaddr_in serv_addr;
    fd_set readfds;
    char name[50], buf[SIZE];
    char welcome[SIZE];

    sockfd = socket(AF_INET, SOCK_STREAM, 0);

    if (sockfd < 0) {
        perror("socket");
        return 1;
    }

    memset(&serv_addr, 0, sizeof(serv_addr));
    serv_addr.sin_family = AF_INET;
    serv_addr.sin_port = htons(PORT);
    inet_pton(AF_INET, "127.0.0.1",
              &serv_addr.sin_addr);

    if (connect(sockfd, (struct sockaddr *)&serv_addr,
                sizeof(serv_addr)) < 0) {
        perror("connect");
        close(sockfd);
        return 1;
    }

    printf("Enter your name: ");

    if (fgets(name, sizeof(name), stdin) == NULL) {
        close(sockfd);
        return 1;
    }

    name[strcspn(name, "\n")] = '\0';

    if (name[0] == '\0' || strchr(name, '|')) {
        printf("Invalid name.\n");
        close(sockfd);
        return 1;
    }

    snprintf(welcome, sizeof(welcome), "%s\n", name);

    if (send_all(sockfd, welcome) < 0) {
        close(sockfd);
        return 1;
    }

    printf("Connected to chat server!\n");
    printf("Type a message and press Enter.\n");
    printf("Type 'exit' to leave the chat.\n\n");

    while (1) {
        FD_ZERO(&readfds);
        FD_SET(STDIN_FILENO, &readfds);
        FD_SET(sockfd, &readfds);

        if (select(sockfd + 1, &readfds,
                   NULL, NULL, NULL) < 0) {
            break;
        }

        if (FD_ISSET(sockfd, &readfds)) {
            int n = recv(sockfd, buf, sizeof(buf) - 1, 0);

            if (n <= 0) {
                printf("\nServer disconnected.\n");
                break;
            }

            buf[n] = '\0';
            printf("%s", buf);
            fflush(stdout);
        }

        if (FD_ISSET(STDIN_FILENO, &readfds)) {
            if (fgets(buf, sizeof(buf), stdin) == NULL)
                break;

            if (send_all(sockfd, buf) < 0)
                break;

            if (strcmp(buf, "exit\n") == 0 ||
                strcmp(buf, "exit") == 0)
                break;
        }
    }

    close(sockfd);
    printf("Disconnected from chat server.\n");

    return 0;
}
