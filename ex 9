#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <pthread.h>
#include <signal.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8084
#define MAX_CLIENTS 100
#define SIZE 1024

struct Client {
    int fd;
    int active;
    char name[50];
};

struct Client clients[MAX_CLIENTS];
pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;

int send_all(int fd, const char *msg) {
    size_t len = strlen(msg), sent = 0;

    while (sent < len) {
        ssize_t n = send(fd, msg + sent, len - sent,
                         MSG_NOSIGNAL);
        if (n <= 0)
            return -1;
        sent += n;
    }
    return 0;
}

int recv_line(int fd, char *buf, int size) {
    int i = 0;
    char ch;

    while (i < size - 1) {
        ssize_t n = recv(fd, &ch, 1, 0);

        if (n <= 0)
            return -1;

        if (ch == '\n')
            break;

        if (ch != '\r')
            buf[i++] = ch;
    }

    buf[i] = '\0';
    return i;
}

void broadcast(const char *msg, int sender_fd) {
    int i;

    pthread_mutex_lock(&lock);

    for (i = 0; i < MAX_CLIENTS; i++) {
        if (clients[i].active &&
            clients[i].fd != sender_fd &&
            clients[i].name[0] != '\0') {

            if (send_all(clients[i].fd, msg) < 0)
                shutdown(clients[i].fd, SHUT_RDWR);
        }
    }

    pthread_mutex_unlock(&lock);
}

void *handle_client(void *arg) {
    int fd = *(int *)arg;
    free(arg);

    char name[50], msg[SIZE], output[SIZE + 100];
    int slot = -1, i;

    if (recv_line(fd, name, sizeof(name)) <= 0 ||
        name[0] == '\0') {
        close(fd);
        return NULL;
    }

    pthread_mutex_lock(&lock);

    for (i = 0; i < MAX_CLIENTS; i++) {
        if (clients[i].active && clients[i].fd == fd) {
            slot = i;
            snprintf(clients[i].name,
                     sizeof(clients[i].name), "%s", name);
            break;
        }
    }

    pthread_mutex_unlock(&lock);

    if (slot == -1) {
        close(fd);
        return NULL;
    }

    snprintf(output, sizeof(output),
             "[Server] %s joined the chat.\n", name);
    broadcast(output, fd);

    printf("%s joined.\n", name);

    while (recv_line(fd, msg, sizeof(msg)) > 0) {
        if (strcmp(msg, "exit") == 0)
            break;

        if (msg[0] == '\0')
            continue;

        snprintf(output, sizeof(output), "%s: %s\n",
                 name, msg);

        printf("%s", output);
        broadcast(output, fd);
    }

    pthread_mutex_lock(&lock);
    clients[slot].active = 0;
    clients[slot].name[0] = '\0';
    clients[slot].fd = -1;
    pthread_mutex_unlock(&lock);

    snprintf(output, sizeof(output),
             "[Server] %s left the chat.\n", name);
    broadcast(output, fd);

    printf("%s disconnected.\n", name);
    close(fd);

    return NULL;
}

int main(void) {
    int server_fd, client_fd, opt = 1, i;
    struct sockaddr_in addr;

    signal(SIGPIPE, SIG_IGN);

    for (i = 0; i < MAX_CLIENTS; i++) {
        clients[i].fd = -1;
        clients[i].active = 0;
        clients[i].name[0] = '\0';
    }

    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd < 0) {
        perror("socket");
        return 1;
    }

    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR,
               &opt, sizeof(opt));

    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = htonl(INADDR_ANY);
    addr.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&addr,
             sizeof(addr)) < 0) {
        perror("bind");
        close(server_fd);
        return 1;
    }

    if (listen(server_fd, 10) < 0) {
        perror("listen");
        close(server_fd);
        return 1;
    }

    printf("Concurrent chat server running on port %d...\n",
           PORT);

    while (1) {
        pthread_t tid;
        int slot = -1;
        int *arg;

        client_fd = accept(server_fd, NULL, NULL);

        if (client_fd < 0) {
            perror("accept");
            continue;
        }

        pthread_mutex_lock(&lock);

        for (i = 0; i < MAX_CLIENTS; i++) {
            if (!clients[i].active) {
                slot = i;
                clients[i].fd = client_fd;
                clients[i].active = 1;
                clients[i].name[0] = '\0';
                break;
            }
        }

        pthread_mutex_unlock(&lock);

        if (slot == -1) {
            send_all(client_fd, "Server full. Try later.\n");
            close(client_fd);
            continue;
        }

        arg = malloc(sizeof(int));

        if (arg == NULL) {
            pthread_mutex_lock(&lock);
            clients[slot].active = 0;
            clients[slot].fd = -1;
            pthread_mutex_unlock(&lock);
            close(client_fd);
            continue;
        }

        *arg = client_fd;

        if (pthread_create(&tid, NULL,
                           handle_client, arg) != 0) {
            free(arg);
            pthread_mutex_lock(&lock);
            clients[slot].active = 0;
            clients[slot].fd = -1;
            pthread_mutex_unlock(&lock);
            close(client_fd);
            continue;
        }

        pthread_detach(tid);
    }

    close(server_fd);
    return 0;
}
